<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="com.autonavi.amapauto.permission.RECEIVE_BROADCAST" />
    <uses-permission android:name="autonavi.permission.RECEIVE_BROADCAST" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <application
        android:name=".NavBleApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_navigation"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NavBleRelay"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".BleLogActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <service
            android:name=".service.NavBleService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".receiver.NavBroadcastReceiver"
            android:exported="true"
            android:priority="999">
            <intent-filter android:priority="999">
                <action android:name="AUTONAVI_STANDARD_BROADCAST_SEND" />
                <action android:name="AUTONAVI_STANDARD_BROADCAST_RECV" />
                <action android:name="com.autonavi.amapauto.ACTION_STANDARD_BROADCAST_SEND" />
                <action android:name="com.autonavi.amapauto.ACTION_STANDARD_BROADCAST_RECV" />
                <action android:name="com.autonavi.amapauto.action.STANDARD_BROADCAST" />
                <action android:name="com.autonavi.action.STANDARD_BROADCAST_SEND" />
                <action android:name="com.autonavi.minimap.ACTION_BROADCAST" />
                <action android:name="com.autonavi.minimap.action.NAV_INFO" />
                <action android:name="com.autonavi.action.NAVIGATION_INFO" />
                <action android:name="AUTONAVI_NAVI_INFO" />
                <action android:name="AutonaviNaviInfo" />
                <action android:name="com.autonavi.autonavi.action.BROADCAST_SEND" />
                <action android:name="com.navblerelay.SELF_TEST" />
            </intent-filter>
        </receiver>

    </application>

</manifest>