<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:colorBackground"
    android:padding="16dp">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_navigation"
            android:layout_marginEnd="10dp"
            app:tint="@color/md_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_app"
            android:textSize="20sp"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu_settings"
            app:tint="@color/md_on_surface_variant" />

        <ImageButton
            android:id="@+id/btn_about"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_about"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu_about"
            app:tint="@color/md_on_surface_variant" />
    </LinearLayout>

    <!-- 服务控制卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg_dark"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/service_control"
            android:textSize="11sp"
            android:textColor="@color/md_on_surface_variant"
            android:letterSpacing="0.08"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/start_service"
            android:textSize="15sp"
            android:textColor="@color/md_on_primary"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:background="@drawable/btn_start_bg"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/stop_service"
            android:textSize="15sp"
            android:textColor="@color/md_error"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:background="@drawable/btn_stop_bg"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:enabled="false"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_test_broadcast"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="@string/test_broadcast"
            android:textSize="13sp"
            android:textColor="@color/md_warning"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:background="@drawable/btn_test_bg"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 状态概览卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg_dark"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status"
            android:textSize="11sp"
            android:textColor="@color/md_on_surface_variant"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="@string/ble"
                android:textSize="13sp"
                android:textColor="@color/md_on_surface_variant" />
            <View
                android:id="@+id/status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/status_dot_red"
                android:layout_marginEnd="8dp" />
            <TextView
                android:id="@+id/status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/status_stopped"
                android:textSize="13sp"
                android:textColor="@color/md_on_surface"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="@string/status"
                android:textSize="13sp"
                android:textColor="@color/md_on_surface_variant" />
            <TextView
                android:id="@+id/ble_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/status_disconnected"
                android:textSize="13sp"
                android:textColor="@color/md_status_disconnected" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/broadcast_status_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone">
            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="@string/broadcast"
                android:textSize="13sp"
                android:textColor="@color/md_on_surface_variant" />
            <TextView
                android:id="@+id/broadcast_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/status_waiting"
                android:textSize="13sp"
                android:textColor="@color/md_warning" />
        </LinearLayout>
    </LinearLayout>

    <!-- 数据卡片容器 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="ifContentScrolls"
        android:fadeScrollbars="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 导航状态 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg_dark"
                android:padding="16dp"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/navigation"
                    android:textSize="11sp"
                    android:textColor="@color/md_primary"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="10dp" />
                <include layout="@layout/item_kv" android:id="@+id/row_map_state" />
                <include layout="@layout/item_kv" android:id="@+id/row_cross_map" />
            </LinearLayout>

            <!-- 引导信息 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg_dark"
                android:padding="16dp"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guidance"
                    android:textSize="11sp"
                    android:textColor="@color/md_primary"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="10dp" />
                <include layout="@layout/item_kv" android:id="@+id/row_cur_road" />
                <include layout="@layout/item_kv" android:id="@+id/row_next_road" />
                <include layout="@layout/item_kv" android:id="@+id/row_route_remain" />
                <include layout="@layout/item_kv" android:id="@+id/row_cur_speed" />
                <include layout="@layout/item_kv" android:id="@+id/row_limited_speed" />
                <include layout="@layout/item_kv" android:id="@+id/row_camera_dist" />
                <include layout="@layout/item_kv" android:id="@+id/row_sapa_dist" />
                <include layout="@layout/item_kv" android:id="@+id/row_traffic_light" />
            </LinearLayout>

            <!-- 车道指引 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg_dark"
                android:padding="16dp"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/drive_way"
                    android:textSize="11sp"
                    android:textColor="@color/md_primary"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="10dp" />
                <include layout="@layout/item_kv" android:id="@+id/row_drive_way_size" />
                <include layout="@layout/item_kv" android:id="@+id/row_drive_way_detail" />
            </LinearLayout>

            <!-- 路况光柱 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg_dark"
                android:padding="16dp"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/traffic_bar"
                    android:textSize="11sp"
                    android:textColor="@color/md_primary"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="10dp" />
                <include layout="@layout/item_kv" android:id="@+id/row_tmc_total" />
                <include layout="@layout/item_kv" android:id="@+id/row_tmc_remain" />
                <include layout="@layout/item_kv" android:id="@+id/row_tmc_segments" />
            </LinearLayout>

            <!-- 定位信息 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg_dark"
                android:padding="16dp"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/location"
                    android:textSize="11sp"
                    android:textColor="@color/md_primary"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="10dp" />
                <include layout="@layout/item_kv" android:id="@+id/row_loc_speed" />
                <include layout="@layout/item_kv" android:id="@+id/row_loc_bearing" />
                <include layout="@layout/item_kv" android:id="@+id/row_loc_accuracy" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="24dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
