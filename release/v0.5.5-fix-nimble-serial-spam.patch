diff --git a/Auto/platformio.ini b/Auto/platformio.ini
index 8c23871..3c1dbb4 100644
--- a/Auto/platformio.ini
+++ b/Auto/platformio.ini
@@ -32,7 +32,7 @@ lib_deps =
     bodmer/TFT_eSPI @ ^2.5.43
 
 build_flags =
-    -D CORE_DEBUG_LEVEL=3
+    -D CORE_DEBUG_LEVEL=1
     -D SERIAL_BAUD=115200
     -D ARDUINOJSON_ENABLE_STD_STRING=1
     ; 禁用 ESP32 Arduino 内置 BLE 库（避免 NimBLE-Arduino 冲突）
@@ -40,6 +40,8 @@ build_flags =
     ; 增大 NimBLE 协议栈任务栈大小（默认 4096 不够）
     ; 5 个特征值 × 回调链（onWrite + onSubscribe）会消耗大量栈空间
     -D CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
+    ; 编译期限制 NimBLE 协议栈自身日志级别为 ERROR，防止 subscribe/mtu spam
+    -D CONFIG_BT_NIMBLE_LOG_LEVEL=1
 
 ; ============================================================
 ; 环境 1：ESP32-S3 Super Mini（主力环境）
@@ -96,7 +98,7 @@ board_build.partitions = default.csv
 ; 环境 2：ESP32-C3 Super Mini（向后兼容，仅串口虚拟屏幕）
 ; ============================================================
 [env:esp32-c3-supermini]
-platform = espressif32
+platform = espressif32@6.5.0
 board = esp32-c3-devkitm-1
 framework = ${common.framework}
 monitor_speed = ${common.monitor_speed}
