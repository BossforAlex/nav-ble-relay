+    esp_log_level_set("NimBLEClient", ESP_LOG_NONE);
+    esp_log_level_set("NimBLEScan", ESP_LOG_NONE);
+    // 兜底：把全局默认日志级别提到 WARN，避免某些组件在运行时被设回 INFO
+    esp_log_level_set("*", ESP_LOG_WARN);
